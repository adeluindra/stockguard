# Copy to .env once, then replace the password with a unique local value.
# Never commit .env, use real production secrets in deployment.
POSTGRES_USER=stockguard
POSTGRES_DB=stockguard_dev
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LOCAL_PASSWORD
# Avoid collisions with DevJourney PostgreSQL on port 5432.
POSTGRES_PORT=5433
